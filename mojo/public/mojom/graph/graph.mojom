// Mojo interface definitions for Spec 01 — Decentralised Identity.
// Defines the IPC contract between the Blink renderer and the browser process
// for DID credential management (navigator.credentials / DIDCredential).
//
// Later specs extend this module in their own branches: Spec 02 adds the
// SemanticTriple / PersonalGraph interfaces, Spec 05 the sync surface, and so
// on. This base introduces only the identity types.

module graph.mojom;

// Cryptographic proof (Spec 01 §6.1). Attached to SignedContent.
struct ContentProof {
  string method;     // verification method id (DID URI + fragment)
  string signature;  // multibase(base58btc, 'z') Ed25519 signature
  string type;       // "Ed25519Signature2020"
};

// ============================================================
// DIDCredentialService — decentralised identity management
// ============================================================

struct DIDCredentialInfo {
  string id;           // Credential ID
  string did;          // did:key:... URI
  string algorithm;    // "Ed25519"
  string display_name;
  string created_at;   // RFC 3339
  bool is_locked;
};

struct SignedContent {
  string author;       // DID URI
  string timestamp;    // RFC 3339
  string data_json;    // JSON-serialized signed data
  ContentProof proof;
};

interface DIDCredentialService {
  // Create a new DID credential (Ed25519 keypair).
  CreateCredential(string display_name, string algorithm)
      => (DIDCredentialInfo? credential);

  // List all DID credentials.
  ListCredentials() => (array<DIDCredentialInfo> credentials);

  // Get the active (default) credential.
  GetActiveCredential() => (DIDCredentialInfo? credential);

  // Set the active credential.
  SetActiveCredential(string credential_id) => (bool success);

  // Delete a credential.
  DeleteCredential(string credential_id) => (bool success);

  // Sign data with a credential. Canonicalises |data_json| with JCS
  // [[RFC8785]] before hashing and signing (§6.1/§6.4).
  Sign(string credential_id, string data_json) => (SignedContent? result);

  // Sign a ZCAP-LD capability document (§6.3). Rejects payloads that are not
  // JSON objects.
  SignCapability(string credential_id, string zcap_json)
      => (SignedContent? result);

  // Sign raw bytes verbatim (§6.5) — no canonicalisation, hashing, timestamp,
  // or framing. Returns the raw 64-byte Ed25519 signature.
  SignRaw(string credential_id, array<uint8> payload)
      => (array<uint8>? signature);

  // Verify signed content.
  Verify(SignedContent content) => (bool valid);

  // Lock/unlock a credential.
  Lock(string credential_id) => (bool success);
  Unlock(string credential_id) => (bool success);

  // Resolve a did:key to a DID Document.
  ResolveDID(string did) => (string? did_document_json);
};

// ============================================================
// Spec 02 — Personal Linked Data Graphs
//
// The renderer-facing navigator.graph surface (blink PersonalGraphManager /
// PersonalGraph) is backed by these browser-process interfaces. The browser
// owns the Oxigraph-backed graph store; the renderer holds thin wrappers. All
// cryptographic material (reifier signatures, snapshot proofs) is produced in
// the browser via the Spec 01 DIDCredentialService identity, never in the
// renderer.
// ============================================================

// §3.3 Graph.trustLevel. Later specs MAY extend this enum.
enum GraphTrustLevel {
  kLocal,
  kExternal,
};

// §5.3 SnapshotFormat. Later specs MAY extend this enum.
enum SnapshotFormat {
  kNQuadsCanonical,
  kNQuads,
  kTurtle,
  kJsonLd,
};

// §5.3 GraphSignBy.
enum GraphSignBy {
  kAgent,
  kGraph,
  kBoth,
};

// §3.1 LiteralValue.
struct LiteralValue {
  string lexical;
  string datatype;      // XSD URI; "…#string" when unset by the caller
  string? language;     // BCP 47; only meaningful for rdf:langString
};

// §3.1 Triple.object — an IRI, a blank node (identifier beginning "_:"), or a
// literal. |literal| takes precedence when present; otherwise |iri_or_bnode|
// carries the IRI or the "_:"-prefixed blank-node label.
union TripleObject {
  string iri_or_bnode;
  LiteralValue literal;
};

// §3.1 Triple.
struct Triple {
  string subject;       // IRI or "_:"-prefixed blank node
  string predicate;     // IRI (REQUIRED)
  TripleObject object;
};

// §3.7 Reifier — the per-triple provenance record.
struct Reifier {
  string id;            // blank-node identifier in the current graph state
  Triple triple;        // the reified data triple
  string author;        // prov://author (a DID URI)
  string timestamp;     // prov://timestamp (RFC 3339)
  string method;        // prov://method (verification method URI)
  string signature;     // prov://signature (multibase-encoded)
};

// §3.5 TripleQuery. Every supplied field combines with logical AND.
struct TripleQuery {
  string? subject;
  string? predicate;
  TripleObject? object;
  string? author;       // matches reifier prov://author
  string? from_date;    // RFC 3339; matches prov://timestamp >= from_date
  string? until_date;   // RFC 3339; matches prov://timestamp <  until_date
  uint64? offset;
  uint64? limit;
};

// §5.3 SnapshotProof.
struct SnapshotProof {
  string role;          // "agent" or "graph"
  string author;        // signing DID
  string method;        // verification method URI
  string signature;     // multibase-encoded
};

// §5.3 GraphSnapshot.
struct GraphSnapshot {
  string graph_iri;
  string? graph_did;
  SnapshotFormat format;
  string timestamp;
  string data;          // serialised triples (data + reifier triples)
  array<SnapshotProof> proofs;
};

// The attributes needed to construct a renderer-side PersonalGraph (§3.3). The
// browser returns one when a graph is created or materialised, alongside the
// bound PersonalGraphHost.
struct GraphInfo {
  string id;            // stable internal URN (urn:graph:<uuid>)
  string iri;           // current graph://<content-hash>
  string? did;
  string? display_name;
  GraphTrustLevel trust_level;
};

// The outcome of a SPARQL 1.2 evaluation (§4.2 querySparql). |kind|: 0
// Solutions (SELECT), 1 Boolean (ASK), 2 Graph (CONSTRUCT/DESCRIBE). |payload|
// is SPARQL 1.1 JSON Results, or RDF 1.2 N-Triples for graph results.
struct SparqlQueryResult {
  bool ok;
  string error;         // DOMException name when !ok (e.g. "TimeoutError")
  uint8 kind;
  string payload;
};

// PersonalGraphHost — the browser-process host for a single graph (§4/§5/§7).
// One receiver is bound per Graph handed to a renderer; the browser owns the
// underlying Oxigraph store. Every method that can fail returns a DOMException
// name in |error| (null on success); operations on a dissolved graph return
// "InvalidStateError".
interface PersonalGraphHost {
  // §5.2 the current content-address IRI.
  GetIri() => (string? iri, string? error);

  // §4.2 mutation. Each successful ack carries the post-mutation |iri| (§4.2
  // step 6 / §5.2) so the renderer's Graph.iri is current the moment the promise
  // resolves; |iri| is null on failure (|error| set) or if the IRI could not be
  // recomputed. Cross-realm observers instead refresh via the pushed events.
  AddTriple(Triple triple) => (Triple? added, string? iri, string? error);
  AddTriples(array<Triple> triples)
      => (array<Triple>? added, string? iri, string? error);
  RemoveTriple(Triple triple) => (bool removed, string? iri, string? error);

  // §4.2 / §7.2 read.
  QueryTriples(TripleQuery query) => (array<Triple>? triples, string? error);
  Snapshot() => (array<Triple>? triples, string? error);
  Provenance(Triple triple) => (array<Reifier>? reifiers, string? error);
  // |named_graph_ids| are internal ids of sibling graphs to include as named
  // graphs in the dataset (§7.2); the browser resolves them against the graphs
  // it owns. |timeout_ms| null means no timeout.
  QuerySparql(string sparql,
              array<string> named_graph_ids,
              uint64? timeout_ms) => (SparqlQueryResult result);

  // §5.4 export.
  GetAsSnapshot(SnapshotFormat format, GraphSignBy sign_by)
      => (GraphSnapshot? snapshot, string? error);

  // §4.3 dissolve (idempotent).
  Dissolve() => ();

  // §4.2/§4.4 event delivery — the browser pushes tripleadded/tripleremoved.
  Subscribe(pending_remote<PersonalGraphClient> client);

  // ---- Spec 04 §11 governance API (folded into this host; see the Spec 04
  // section below). Every call runs against the single per-realm
  // GovernanceBackend the browser shares across all graphs. |canAddTriple| and
  // |myCapabilities| resolve the *current* identity in the browser (§11.1/§11.3);
  // |canPerformAction| authorises an explicitly named author (§7.1). Results are
  // advisory — the mandatory data-layer gate lives in AddTriple/AddTriples. ----

  // §11.1 canAddTriple: would the current identity be permitted to add |triple|?
  CanAddTriple(Triple triple)
      => (GovernanceValidationResult result, string? error);
  // §7.1 non-triple authorisation (e.g. mountContext). |proof|, when present,
  // supplies the explicit leaf→root delegation chain (CapabilityProofInput).
  CanPerformAction(string action, string author_did, CapabilityProofInput? proof)
      => (GovernanceValidationResult result, string? error);
  // §11.2 constraintsFor: the constraints bound to this graph (per-graph;
  // |context_did| is accepted for API parity but ignored — see §11.2).
  ConstraintsFor(string context_did)
      => (array<GraphConstraint>? constraints, string? error);
  // §11.3 myCapabilities: valid, non-revoked, non-expired capabilities the
  // current identity holds for this graph.
  MyCapabilities() => (array<CapabilityInfo>? capabilities, string? error);
  // §11.4 enforcementMode.
  GetEnforcementMode() => (EnforcementMode mode, string? error);
  // §11.4 setEnforcementMode: requires an updateGovernance capability (§5.2);
  // "NotAllowedError" otherwise.
  SetEnforcementMode(EnforcementMode mode) => (string? error);
};

// PersonalGraphClient — the renderer sink for graph events (§4.2, §4.4). The
// browser invokes these in commit order.
interface PersonalGraphClient {
  OnTripleAdded(Triple triple);
  OnTripleRemoved(Triple triple);
};

// PersonalGraphManager — the browser-process host for navigator.graph (§3.4,
// §4.1, §5.5). Per-realm; the renderer creates the PersonalGraphHost pipe and
// passes the receiver, which the browser binds to the new/materialised graph.
interface PersonalGraphManager {
  // §4.1 create a fresh, empty, local graph.
  Create(string? display_name,
         pending_receiver<PersonalGraphHost> receiver) => (GraphInfo? info);

  // §5.5 verify and materialise a graph from a snapshot. On failure |info| is
  // null and |error| is the DOMException name.
  FromSnapshot(GraphSnapshot snapshot,
               GraphTrustLevel trust,
               pending_receiver<PersonalGraphHost> receiver)
      => (GraphInfo? info, string? error);
};

// ============================================================
// Spec 03 — Decentralised Group Identity
//
// A "group" is a Graph (Spec 02) that has been *groupified* (§4.2): a fresh
// Ed25519 keypair is minted, a did:graph is derived from it, and the binding +
// seed DID-document triples are written into the host graph. The group's DID
// document *is* triples in the host graph, so there is no separate wire format —
// managing a delegate is authoring did://* triples and resolving the DID is
// projecting them back. Every did:graph private key lives in the browser
// identity backend, so group-authored writes are signed there, never in the
// renderer. Signing authority (DID-document delegates, §5/§7.2) and
// participation (context://participates_in / accepts_participation, §6.2/§7.1)
// are kept structurally separate exactly as §7 requires.
//
// The renderer-facing navigator.graph surface (blink GraphManager gains
// createGroup/groupify/forkGroup/openGroup/groups; blink Group) is backed by
// these browser-process interfaces.
// ============================================================

// §5.1 the four capability sections a verification method may be referenced
// from. There is deliberately no aggregate/threshold section — a signature by
// any current method in the relevant section is a signature by the DID.
enum DIDCapabilitySection {
  kCapabilityInvocation,
  kCapabilityDelegation,
  kAssertionMethod,
  kAuthentication,
};

// §4.4 a DID-document verification method, as supplied to addSigner/addDelegate.
struct DIDDocumentMethod {
  string id;                    // "<did>#<publicKeyMultibase>"
  string type;                  // "Ed25519VerificationKey2020"
  string controller;            // the group DID
  string public_key_multibase;  // "z6Mk..."
};

// §4.4 a resolved verification method plus the sections that currently reference
// it (the projection of the group's did://* membership triples).
struct VerificationMethodInfo {
  string id;
  string type;
  string controller;
  string public_key_multibase;
  array<DIDCapabilitySection> sections;
};

// §4.4 / §4.7 a projected did:graph DID document. |document_json| is the
// [[DID-CORE]] JSON-LD projection resolve() returns; the structured fields let
// the renderer answer signers()/isSigner() without reparsing it.
struct DidDocumentInfo {
  string id;
  array<VerificationMethodInfo> verification_method;
  array<string> capability_invocation;   // verification-method ids
  array<string> capability_delegation;
  array<string> assertion_method;
  array<string> authentication;
  bool deactivated;
  string trust_level;                    // "local" for a local mount (§4.7)
  string document_json;
};

// §8.1 Participant — a direct or transitive member of a group.
struct ParticipantInfo {
  string did;         // participant IRI or did:graph
  bool is_group;      // true iff a did:graph
  string joined_at;   // RFC 3339, from the accepts_participation reifier
  string? name;       // group://name of the participant, when locally resolvable
};

// The attributes needed to construct a renderer-side Group (§8.1). The browser
// returns one when a group is created, forked, groupified, or opened, alongside
// the bound GroupHost and (for a freshly materialised host graph) the
// PersonalGraphHost the Group's `graph` attribute wraps.
struct GroupInfo {
  string did;             // did:graph:...
  GraphInfo graph;        // the underlying, groupified host graph (§3.3)
  string? name;
  string? description;
  string? created;        // RFC 3339
  string? creator;        // DID URI of the creating agent (§4.2)
};

// §8.2 GroupCreationOptions. |sync_module| is REQUIRED (§4.5).
struct GroupCreationOptions {
  string sync_module;
  string? display_name;
  string? description;
  array<string> initial_delegates;  // extra capabilityInvocation delegate DIDs
  string? participates_in;          // parent IRI or did:graph to join (§7.1)
};

// §8.2 GroupifyOptions. |sync_module| is REQUIRED (§4.5).
struct GroupifyOptions {
  string sync_module;
  string? display_name;
  string? description;
  array<string> initial_delegates;
};

// §8.2 ForkOptions. |sync_module| is REQUIRED (MAY equal the parent's, §4.8.1).
struct ForkOptions {
  string sync_module;
  string? fork_revision;            // defaults to the parent's current IRI
  bool announce_fork;               // write group://forkedTo on the parent (§4.8)
  array<string> initial_delegates;
  string? display_name;
  string? description;
};

// GroupHost — the browser-process host for a single group (§5/§6/§7/§8.1). One
// receiver is bound per Group handed to a renderer, over the same backend as the
// group's PersonalGraphHost. Governed mutations are authored by the group's
// current "acting" delegate (SetActingCredential, defaulting to the group's own
// initial key, which holds all four sections so a group-of-one works out of the
// box, §11). Every fallible method returns a DOMException name in |error| (null
// on success): "NotAllowedError" when the acting credential lacks the required
// section delegate (§5.4/§6.2), "InvalidStateError" for a brick-state guard
// (§5.4) or a failed assertion, "NotFoundError" for an unresolved target.
interface GroupHost {
  // §8.1 SetActingCredential: choose which delegate key authors subsequent
  // governed writes and signs assertions. |credential_id| empty restores the
  // group's own initial key.
  SetActingCredential(string credential_id) => ();

  // ---- participation (§6.2, §7.1, §8.1.1-8.1.3) ----

  // §8.1.1 invite: accept |participant| into the group (capabilityDelegation
  // authorship, §6.2).
  Invite(string participant) => (string? error);
  // §8.1.2 revokeParticipation: remove the acceptance (capabilityDelegation).
  RevokeParticipation(string participant) => (string? error);
  HasParticipant(string participant) => (bool has);
  // §8.1.3 participants: the direct participant set.
  Participants() => (array<ParticipantInfo> participants);
  // §8.1.3 transitiveParticipants: every individual reachable by descending into
  // participating sub-groups, cycle-safe with a depth cap of 16 (§6.3/§13.7).
  TransitiveParticipants() => (array<ParticipantInfo> participants);
  // §8.1 parentGroups: the locally-mounted groups this group participates in.
  ParentGroups() => (array<string> parent_dids);
  // §8.1 childGroups: the participants that are themselves locally-mounted groups.
  ChildGroups() => (array<string> child_dids);

  // ---- signing authority / delegate management (§5, §7.2, §8.1.4) ----

  // §8.1 signers: the DID-document verification methods and their section
  // memberships (the renderer filters by section for signers(section)).
  Signers() => (array<VerificationMethodInfo> methods);
  // §8.1.4 / §5.4 addSigner (== addDelegate).
  AddSigner(DIDDocumentMethod method, array<DIDCapabilitySection> sections)
      => (string? error);
  // §8.1.4 / §5.4 removeSigner (== removeDelegate); "InvalidStateError" if it is
  // the sole capabilityDelegation member (§5.4 brick-state guard).
  RemoveSigner(string method_id) => (string? error);
  // §5.4 grantSection.
  GrantSection(string method_id, DIDCapabilitySection section)
      => (string? error);
  // §5.4 revokeSection; "InvalidStateError" if |section| is capabilityDelegation
  // and |method_id| is its only member (brick-state guard).
  RevokeSection(string method_id, DIDCapabilitySection section)
      => (string? error);
  // §8.1 isSigner: whether |delegate_did|'s key is currently a signer, and in
  // which sections (empty when not a signer).
  IsSigner(string delegate_did)
      => (bool is_signer, array<DIDCapabilitySection> sections);

  // ---- assertion + resolution + deactivation (§5.4, §4.7, §4.9) ----

  // §5.4 signGraph over a target graph IRI or did:graph (assertionMethod
  // delegate). Reuses the Spec 01 SignedContent proof shape.
  SignGraph(string target) => (SignedContent? result, string? error);
  // §4.7 resolve (local): the group's current DID document.
  Resolve() => (DidDocumentInfo? document, string? error);
  // §4.9 deactivate (capabilityDelegation).
  Deactivate() => (string? error);

  // §8.1.5 delegateCapability (Spec 04 §4.5.3): issue a ZCAP whose resource is
  // this group's did:graph (or another did:graph the group has authority over),
  // signed by a current capabilityDelegation delegate. The browser resolves the
  // signer, attenuates against the group's root capability, writes the ZCAP into
  // the host graph, and returns it framed as SignedContent. "NotAllowedError"
  // when no held capability carries delegateCapability for the target, "DataError"
  // when the requested attenuation is invalid.
  DelegateCapability(DelegateOptions options)
      => (SignedContent? result, string? error);
};

// GroupManager — the browser-process host for the navigator.graph group surface
// (§8.2). Per-realm; mints and materialises groups over the same graph backends
// as PersonalGraphManager. createGroup/forkGroup/openGroup each mint a fresh
// host-graph PersonalGraphHost pipe (the Group's `graph`) plus a GroupHost pipe;
// groupify reuses the caller's existing graph (identified by its internal id) and
// only binds a GroupHost. Failures return a DOMException name in |error|.
interface GroupManager {
  // §8.2 createGroup: allocate a fresh host graph and groupify it.
  CreateGroup(GroupCreationOptions options,
              pending_receiver<GroupHost> group_receiver,
              pending_receiver<PersonalGraphHost> graph_receiver)
      => (GroupInfo? info, string? error);

  // §8.2 groupify: turn an existing, caller-owned graph (named by its internal
  // id) into a group. "InvalidStateError" if it is already a group (§4.2 is
  // one-way) or the id is unknown.
  Groupify(string graph_id,
           GroupifyOptions options,
           pending_receiver<GroupHost> group_receiver)
      => (GroupInfo? info, string? error);

  // §8.2 forkGroup (§4.8): mint a fresh identity, copy the parent's graph state,
  // strip the parent identity, and write the child seed. |parent| is a did:graph
  // or a current IRI of a locally-mounted group.
  ForkGroup(string parent,
            ForkOptions options,
            pending_receiver<GroupHost> group_receiver,
            pending_receiver<PersonalGraphHost> graph_receiver)
      => (GroupInfo? info, string? error);

  // §8.2 openGroup: a handle over an already-known group named by did:graph or
  // current IRI. "NotFoundError" when it is not locally mounted (§4.7).
  OpenGroup(string iri_or_did,
            pending_receiver<GroupHost> group_receiver,
            pending_receiver<PersonalGraphHost> graph_receiver)
      => (GroupInfo? info, string? error);

  // §8.2 groups: the did:graph of every group this realm currently mounts. The
  // renderer materialises each into a Group via openGroup.
  ListGroups() => (array<string> dids);
};

// ============================================================
// Spec 04 — Graph Capability Framework (ZCAP-LD)
//
// Authority over a Spec 02 graph is *constituted*: a root capability is minted
// at graph creation (§4.3), delegations attenuate downward (§8), and a governed
// write is accepted only if its author holds a valid capability chain
// terminating at the graph's own root (§7). The browser owns the single
// per-realm GovernanceBackend (the C++ port of living_web::GovernanceEngine); it
// carries the plug-in registry and operates on whichever graph a call targets.
//
// There is no separate governance host: the §11 renderer surface is folded into
// PersonalGraphHost above and group-scoped delegation (§8.1.5) into GroupHost,
// because both already own a browser-side host over the graph the capabilities
// are constituted on. All delegation signing uses the Spec 01 identity in the
// browser, never the renderer.
// ============================================================

// §11 EnforcementMode (§5.1): "open" skips capability checks, "announced" makes
// them advisory, "enforced" makes them a mandatory data-layer gate.
enum EnforcementMode {
  kOpen,
  kAnnounced,
  kEnforced,
};

// §11 GovernanceValidationResult. |mode| is the current enforcement-mode token
// ("open" | "announced" | "enforced"); the reject fields are empty when allowed.
struct GovernanceValidationResult {
  bool allowed;
  string rejected_by;      // constraint id
  string constraint_kind;  // "capability" | <plug-in kind>
  string reason;
  string mode;
};

// One defining triple of a constraint subject, carried by GraphConstraint. Mojo
// has no pair type; this mirrors the IDL record<USVString, USVString> entry
// (blink represents that record as an ordered vector of pairs, so duplicate
// predicates survive — a map would collapse them).
struct GraphConstraintProperty {
  string predicate;
  string value;
};

// §11 GraphConstraint. |properties| carries every defining triple of the
// constraint subject except entry_type/constraint_kind.
struct GraphConstraint {
  string id;
  string kind;
  string scope;  // the graph DID this constraint is bound to
  array<GraphConstraintProperty> properties;
};

// §11 CapabilityInfo. |caveats| is the verbatim JSON array literal the IDL
// exposes as sequence<object>, or "" when the capability carries none.
struct CapabilityInfo {
  string id;
  array<string> actions;
  string resource;
  string caveats;
  string? expires;
};

// §11 CapabilityProofInput — an explicitly supplied delegation chain for a
// non-triple authorisation (canPerformAction). |chain| is leaf→root ZCAP
// references resolvable in the target graph; |presentations| are verbatim
// verifiable-credential presentation JSON consumed by `credential` caveats.
struct CapabilityProofInput {
  array<string> chain;
  array<string> presentations;
};

// §8.1.5 DelegateOptions ([[GROUP-IDENTITY]]). |resource| empty defaults to the
// group's own did:graph; |caveats| are verbatim JSON caveat objects.
struct DelegateOptions {
  string invoker;
  array<string> actions;
  string resource;
  array<string> caveats;
  string? expires_at;
};
