// CapabilityInfo — a valid, non-revoked, non-expired capability held by the
// current identity for a graph (Graph.myCapabilities, §11 / §11.3).

dictionary CapabilityInfo {
  required USVString id;
  required sequence<USVString> actions;
  required USVString resource;  // graph DID (RECOMMENDED) or specific-snapshot IRI
  sequence<object> caveats;
  DOMString? expires;           // RFC 3339, when the capability carries an expiry
};
