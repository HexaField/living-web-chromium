// GroupifyOptions — options for GraphManager.groupify(). Decentralised Group
// Identity spec §8.2.

dictionary GroupifyOptions {
  required USVString syncModule;         // content hash of the group's sync module (§4.5)
  DOMString displayName;                 // optional metadata to add at groupification
  DOMString description;
  sequence<USVString> initialDelegates;
};
