// SyncModuleInfo — one entry of the realm's installed-module inventory, returned
// by GraphManager.listModules() (Graph Synchronisation Protocol spec §6.4).

dictionary SyncModuleInfo {
  USVString contentHash;
  USVString? name;
  unsigned long spaceCount;
  ModuleState state;
  unsigned long long storageBytes;
};
