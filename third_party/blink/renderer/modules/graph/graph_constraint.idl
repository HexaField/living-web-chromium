// GraphConstraint — a governance constraint bound to a graph
// (Graph.constraintsFor, §11 / §6.2). Constraints are per-graph; there is no
// inherited or cross-graph component. `properties` carries every defining
// triple of the constraint subject except its entry-type and constraint-kind
// markers.

dictionary GraphConstraint {
  required USVString id;
  required USVString kind;
  required USVString scope;  // graph DID this constraint is bound to
  record<USVString, USVString> properties;
};
