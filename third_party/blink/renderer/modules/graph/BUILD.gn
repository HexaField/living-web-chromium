import("//third_party/blink/renderer/modules/modules.gni")

# Spec 01 — Decentralised Identity, and Spec 02 — Personal Linked Data Graphs.
# The renderer-side surfaces (DIDCredential; navigator.graph -> GraphManager /
# Graph and their value objects) and their supporting types. Later specs add
# their own sources (SharedGraph for Spec 05, and so on) to this target.
#
# IDL files are intentionally not listed here — they are wired separately during
# full-tree integration; only .cc/.h sources belong in blink_modules_sources.
blink_modules_sources("graph") {
  sources = [
    # Spec 01 — Decentralised Identity.
    "content_proof.h",
    "did_credential.cc",
    "did_credential.h",
    "signed_content.cc",
    "signed_content.h",

    # Spec 02 — Personal Linked Data Graphs.
    "graph.cc",
    "graph.h",
    "graph_manager.cc",
    "graph_manager.h",
    "graph_snapshot.cc",
    "graph_snapshot.h",
    "graph_triple_event.cc",
    "graph_triple_event.h",
    "literal_value.cc",
    "literal_value.h",
    "navigator_graph.cc",
    "navigator_graph.h",
    "reifier.cc",
    "reifier.h",
    "snapshot_proof.h",
    "triple.cc",
    "triple.h",
  ]

  deps = [
    "//mojo/public/mojom/graph:graph_blink",
    "//third_party/blink/renderer/core",
    "//third_party/blink/renderer/platform",
  ]
}
