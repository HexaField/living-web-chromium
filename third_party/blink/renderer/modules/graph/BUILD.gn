import("//third_party/blink/renderer/modules/modules.gni")

# Spec 01 — Decentralised Identity, Spec 02 — Personal Linked Data Graphs,
# Spec 03 — Decentralised Group Identity, Spec 04 — Graph Capability Framework,
# Spec 05 — Graph Synchronisation Protocol, Spec 07 — Dynamic Graph Shape
# Validation, and Spec 10 — Graph Flows. The renderer-side surfaces (DIDCredential;
# navigator.graph -> GraphManager / Graph / Group and their value and event objects)
# and their supporting types. Spec 04 folds its governance API onto Graph and adds
# only IDL dictionaries (no new .cc/.h); Spec 05 adds the sync value objects (Peer,
# GraphDiff, PublishedGraph, CapabilityProof) and the events Graph / GraphManager
# dispatch; Spec 07 folds its §5 shape API onto Graph and, like Spec 04, adds only
# IDL dictionaries (ShapeInfo, ShapePropertyInfo, GetShapesOptions — no new
# .cc/.h; the shape-instance data crosses as record<DOMString, sequence<DOMString>>
# and initialValues as record<DOMString, DOMString>); Spec 10 folds its §11 flow API
# onto Graph (FlowInfo / FlowTransitionResult IDL dictionaries) and adds the
# FlowTransitionEvent dispatched for ontransitionfired / ontransitiondeadline.
#
# IDL files are intentionally not listed here — they are wired separately during
# full-tree integration; only .cc/.h sources belong in blink_modules_sources.
blink_modules_sources("graph") {
  sources = [
    # Spec 01 — Decentralised Identity.
    "content_proof.h",
    "did_credential.cc",
    "did_credential.h",
    "signed_content.cc",
    "signed_content.h",

    # Spec 02 — Personal Linked Data Graphs.
    "graph.cc",
    "graph.h",
    "graph_manager.cc",
    "graph_manager.h",
    "graph_snapshot.cc",
    "graph_snapshot.h",
    "graph_triple_event.cc",
    "graph_triple_event.h",
    "literal_value.cc",
    "literal_value.h",
    "navigator_graph.cc",
    "navigator_graph.h",
    "reifier.cc",
    "reifier.h",
    "snapshot_proof.h",
    "triple.cc",
    "triple.h",

    # Spec 03 — Decentralised Group Identity.
    "group.cc",
    "group.h",

    # Spec 05 — Graph Synchronisation Protocol. Sync value objects and the events
    # Graph / GraphManager dispatch. (Spec 04 folded onto Graph; no new sources.)
    "capability_proof.cc",
    "capability_proof.h",
    "diff_event.cc",
    "diff_event.h",
    "graph_diff.cc",
    "graph_diff.h",
    "peer.cc",
    "peer.h",
    "peer_event.cc",
    "peer_event.h",
    "published_graph.cc",
    "published_graph.h",
    "signal_event.cc",
    "signal_event.h",
    "subscription_event.cc",
    "subscription_event.h",
    "sync_state_event.cc",
    "sync_state_event.h",

    # Spec 10 — Graph Flows. Folds its §11 flow API onto Graph (no new .cc/.h for
    # the methods; FlowInfo / FlowTransitionResult are IDL dictionaries) and adds
    # the FlowTransitionEvent dispatched for ontransitionfired / ontransitiondeadline.
    "flow_transition_event.cc",
    "flow_transition_event.h",
  ]

  deps = [
    "//mojo/public/mojom/graph:graph_blink",
    "//third_party/blink/renderer/core",
    "//third_party/blink/renderer/platform",
  ]
}
