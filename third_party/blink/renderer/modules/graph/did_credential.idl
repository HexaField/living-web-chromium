// DIDCredential — a decentralised identity credential (Decentralised Identity
// spec §3, §5.3.2, §6).
//
// Canonical spec surface: `interface DIDCredential : Credential`, created via
// `navigator.credentials.create({ did })` and retrieved via
// `navigator.credentials.get({ did })` (§3.1–§3.2). In a full Chromium tree the
// Credential base and the CredentialsContainer create()/get() dispatch are
// extended per credential_management_did.idl. In this overlay DIDCredential is
// reachable through the navigator.graph identity methods, which return the same
// object with the identical signing surface below.

[Exposed=Window, SecureContext]
interface DIDCredential {
  readonly attribute USVString id;
  readonly attribute USVString did;
  readonly attribute USVString method;      // "key", or any registered method
  readonly attribute DOMString algorithm;   // "Ed25519"
  readonly attribute DOMString displayName;
  readonly attribute DOMString createdAt;    // RFC 3339
  readonly attribute boolean isLocked;

  // §6.1 Signing API.
  [CallWith=ScriptState, NewObject] Promise<SignedContent> sign(any data);
  [CallWith=ScriptState, NewObject] Promise<boolean> verify(SignedContent content);
  [CallWith=ScriptState, NewObject] Promise<SignedContent> signCapability(object zcap);
  [CallWith=ScriptState, NewObject] Promise<ArrayBuffer> signRaw(BufferSource payload);

  // §7 Resolution of this credential's DID document (trustLevel "local").
  [CallWith=ScriptState, NewObject] Promise<any> resolve();

  // §5.3.2 Lock / unlock.
  [CallWith=ScriptState] Promise<undefined> lock();
  [CallWith=ScriptState] Promise<undefined> unlock();
};
