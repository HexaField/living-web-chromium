// ContentProof — cryptographic proof attached to signed data.

[Exposed=(Window,Worker)]
interface ContentProof {
  readonly attribute USVString method;     // verification method id (DID URI + fragment)
  readonly attribute USVString signature;  // multibase-encoded Ed25519 signature
  readonly attribute DOMString type;       // "Ed25519Signature2020"
};
