// GraphTripleEvent — dispatched for Graph.ontripleadded / Graph.ontripleremoved.
// Personal Linked Data Graphs spec §4.2.

[Exposed=(Window,Worker)]
interface GraphTripleEvent : Event {
  constructor(DOMString type, optional GraphTripleEventInit eventInitDict = {});
  readonly attribute Triple triple;
};

dictionary GraphTripleEventInit : EventInit {
  Triple triple;
};
