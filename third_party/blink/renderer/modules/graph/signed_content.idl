// SignedContent — result of DIDCredential.sign() / signCapability().
// Decentralised Identity spec §6.1.

[Exposed=(Window,Worker)]
interface SignedContent {
  readonly attribute USVString author;     // signer DID URI
  readonly attribute DOMString timestamp;  // RFC 3339
  [CallWith=ScriptState] readonly attribute any data;
  readonly attribute ContentProof proof;
};
