// DiffEvent — dispatched for Graph.ondiff (Graph Synchronisation Protocol spec
// §6.3, §16.3). Its `diff` attribute is the diff just applied to the local graph
// (§5.1). Browser-dispatched only; not constructible from script.

[Exposed=(Window,Worker)]
interface DiffEvent : Event {
  readonly attribute GraphDiff diff;
};
