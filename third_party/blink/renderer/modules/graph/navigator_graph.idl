// NavigatorGraph — extends Navigator with the navigator.graph attribute.
// Personal Linked Data Graphs spec §3.4.

[
    Exposed=(Window,Worker),
    SecureContext,
    ImplementedAs=NavigatorGraph
] partial interface Navigator {
  [SameObject] readonly attribute GraphManager graph;
};
