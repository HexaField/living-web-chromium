// Credential Management extension for decentralised identity.
// Decentralised Identity spec §3.1 (creation), §3.2 (retrieval), §4.2 (method
// registry / resolution dispatcher).
//
// These partials attach to Chromium's existing `credentialmanagement` module
// (Credential, CredentialsContainer, CredentialCreationOptions,
// CredentialRequestOptions). During full-tree integration:
//   * `CredentialsContainer::create()` dispatches to DID creation when
//     `options.did` is present (§3.1 steps 1–5), calling the browser-side
//     DIDCredentialService::CreateCredential.
//   * `CredentialsContainer::get()` filters stored DIDCredentials by
//     `options.did.method` and presents the credential picker (§3.2).
//   * `resolve()` / `supportedMethods()` are provided by a
//     Supplement<CredentialsContainer> backed by DIDCredentialService.
// The DIDCredential interface and its full signing surface are defined in
// did_credential.idl and are already reachable via the navigator.graph
// identity methods in this overlay.

// §3.1 Creation options.
partial dictionary CredentialCreationOptions {
  DIDCredentialCreationOptions did;
};

dictionary DIDCredentialCreationOptions {
  required DOMString displayName;
  DOMString method = "key";           // "key" by default; others dispatch to
                                      // registered methods
  DOMString algorithm = "Ed25519";
};

// §3.2 Retrieval options.
partial dictionary CredentialRequestOptions {
  DIDCredentialRequestOptions did;
};

dictionary DIDCredentialRequestOptions {
  BufferSource? challenge;
  USVString method;                   // filter: "key", or any registered method
};

// §4.2 Method registry / §7 resolution dispatcher.
[Exposed=Window, SecureContext]
partial interface CredentialsContainer {
  [NewObject] Promise<any> resolve(USVString did);
  [NewObject] Promise<sequence<DOMString>> supportedMethods();
};
