// EnforcementMode — the governance enforcement level of a graph. Graph
// Capability Framework spec §5.1 / §11. "open" skips capability checks,
// "announced" makes them advisory, "enforced" makes them a mandatory
// data-layer gate.

enum EnforcementMode {
  "open",
  "announced",
  "enforced"
};
