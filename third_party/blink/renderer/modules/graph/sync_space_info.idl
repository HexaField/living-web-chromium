// SyncSpaceInfo — one entry of the realm's active-space inventory, returned by
// GraphManager.listSpaces() (Graph Synchronisation Protocol spec §6.4).

dictionary SyncSpaceInfo {
  USVString spaceUri;
  USVString moduleHash;
  unsigned long graphCount;
  unsigned long peerCount;
};
