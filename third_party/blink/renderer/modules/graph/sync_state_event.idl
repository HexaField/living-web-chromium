// SyncStateEvent — dispatched for Graph.onsyncstatechange (Graph Synchronisation
// Protocol spec §6.3, §16.3). Its `state` attribute is the graph's new sync
// state (§5.5). Browser-dispatched only; not constructible from script.

[Exposed=(Window,Worker)]
interface SyncStateEvent : Event {
  readonly attribute GraphSyncState state;
};
