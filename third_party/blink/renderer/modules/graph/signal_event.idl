// SignalEvent — dispatched for Graph.onsignal (Graph Synchronisation Protocol
// spec §6.3, §11.2). Its `from` attribute is the peer session that sent the
// signal; `payload` is the raw application bytes (§11.3). Signals are ephemeral:
// not diffed, not signed beyond transport authentication, not stored.

[Exposed=(Window,Worker)]
interface SignalEvent : Event {
  readonly attribute Peer from;
  readonly attribute Uint8Array payload;
};
