// MountedGraphInfo — one entry of the realm's mount inventory, returned by
// GraphManager.listMounted() (Graph Synchronisation Protocol spec §6.4).

dictionary MountedGraphInfo {
  USVString graphDid;
  MountMode mode;
  GraphSyncState syncState;
  USVString spaceUri;
  USVString moduleHash;
  unsigned long peerCount;
};
