// Graph — a named, content-addressed set of RDF 1.2 triples. Personal Linked
// Data Graphs spec §3.3.

// §3.3 / §4.2: querySparql resolves with a SPARQL 1.2 result. The spec leaves
// the shape opaque (SPARQL 1.1 Results JSON for SELECT/ASK; N-Triples for
// CONSTRUCT/DESCRIBE), so it is surfaced as `any`.
typedef any SparqlResult;

[Exposed=(Window,Worker), SecureContext]
interface Graph : EventTarget {
  // Stable internal identifier (URN), unchanged for the graph's lifetime.
  readonly attribute USVString id;
  // Current snapshot IRI — graph://<content-hash> of the current triple set.
  readonly attribute USVString iri;
  // Optional DID identifying the graph across all its states. Null when none.
  readonly attribute USVString? did;
  readonly attribute DOMString? displayName;
  // Provenance tag for this graph's local instance — see §7.4.
  readonly attribute GraphTrustLevel trustLevel;

  // Triple operations — §4.2.
  [CallWith=ScriptState, NewObject] Promise<Triple> addTriple(Triple triple);
  [CallWith=ScriptState, NewObject] Promise<sequence<Triple>> addTriples(sequence<Triple> triples);
  [CallWith=ScriptState, NewObject] Promise<boolean> removeTriple(Triple triple);
  [CallWith=ScriptState, NewObject] Promise<sequence<Triple>> queryTriples(TripleQuery query);
  [CallWith=ScriptState, NewObject] Promise<SparqlResult> querySparql(USVString sparql, optional SparqlQueryOptions options = {});
  [CallWith=ScriptState, NewObject] Promise<sequence<Triple>> snapshot();
  [CallWith=ScriptState, NewObject] Promise<sequence<Reifier>> provenance(Triple triple);
  [CallWith=ScriptState, NewObject] Promise<GraphSnapshot> getAsSnapshot(optional GraphSnapshotOptions options = {});
  [CallWith=ScriptState, NewObject] Promise<undefined> dissolve();

  attribute EventHandler ontripleadded;
  attribute EventHandler ontripleremoved;
};

enum GraphTrustLevel { "local", "external" };

// §11 Governance API — added by the Graph Capability Framework
// ([[CAPABILITY-FRAMEWORK]], Spec 04). canAddTriple() and myCapabilities() are
// advisory (UI gating only); the mandatory enforcement point is the data-layer
// check inside addTriple()/addTriples() (§2, §11). Folded onto Graph because the
// browser constitutes a graph's capabilities on that graph's own host.
[Exposed=(Window,Worker), SecureContext]
partial interface Graph {
  // §11.1 — would the current identity be permitted to add |triple|?
  [CallWith=ScriptState, NewObject] Promise<GovernanceValidationResult> canAddTriple(Triple triple);
  // §7.1 — authorise a non-triple operation (e.g. mountContext) for |authorDid|,
  // optionally with an explicitly supplied leaf->root delegation chain.
  [CallWith=ScriptState, NewObject] Promise<GovernanceValidationResult> canPerformAction(USVString action, USVString authorDid, optional CapabilityProofInput proof);
  // §11.2 — the constraints bound to this graph (per-graph; |contextDid| is
  // accepted for API parity but ignored).
  [CallWith=ScriptState, NewObject] Promise<sequence<GraphConstraint>> constraintsFor(USVString contextDid);
  // §11.3 — valid, non-revoked, non-expired capabilities the current identity
  // holds for this graph.
  [CallWith=ScriptState, NewObject] Promise<sequence<CapabilityInfo>> myCapabilities();
  // §11.4 — read/set the enforcement mode; the setter requires an
  // updateGovernance capability (§5.2).
  [CallWith=ScriptState, NewObject] Promise<EnforcementMode> enforcementMode();
  [CallWith=ScriptState, NewObject] Promise<undefined> setEnforcementMode(EnforcementMode mode);
};

// §6 Synchronisation API — added by the Graph Synchronisation Protocol
// ([[SYNC-PROTOCOL]], Spec 05). Publish/unpublish addressing (§6.1), sync-state
// and peer inspection (§6.3), ephemeral signalling (§6.3, §11), and diff
// observation (§6.3). Folded onto Graph because a graph's sync subscription is
// keyed on that graph's own host.
[Exposed=(Window,Worker), SecureContext]
partial interface Graph {
  // §6.1 — publish this graph into a sync space; unpublish tears the
  // subscription down; syncState reports the current lifecycle phase (§5.5).
  [CallWith=ScriptState, NewObject] Promise<PublishedGraph> publish(optional PublishOptions options = {});
  [CallWith=ScriptState, NewObject] Promise<undefined> unpublish();
  [CallWith=ScriptState, NewObject] Promise<GraphSyncState> syncState();

  // §6.3 — peer inspection and pending-diff retrieval.
  [CallWith=ScriptState, NewObject] Promise<sequence<Peer>> peers();
  [CallWith=ScriptState, NewObject] Promise<sequence<Peer>> onlinePeers();
  [CallWith=ScriptState, NewObject] Promise<USVString> currentRevision();
  [CallWith=ScriptState, NewObject] Promise<sequence<GraphDiff>> pendingDiffs();

  // §6.3, §11 — ephemeral signalling. No [NewObject]: no object is returned.
  [CallWith=ScriptState] Promise<undefined> sendSignal(USVString remoteDid, BufferSource payload);
  [CallWith=ScriptState] Promise<undefined> sendSignalToSession(USVString remoteDid, USVString sessionId, BufferSource payload);
  [CallWith=ScriptState] Promise<undefined> broadcast(BufferSource payload);

  attribute EventHandler onpeerjoined;
  attribute EventHandler onpeerleft;
  attribute EventHandler onsyncstatechange;
  attribute EventHandler onsignal;
  attribute EventHandler ondiff;
};

// §5 Shape API — added by Dynamic Graph Shape Validation ([[SHAPE-VALIDATION]],
// Spec 07). A shape is a content-addressed constraint definition (§4) stored as
// triples inside this graph (§6); registration and every instance write are
// governed writes authored by the browser's current identity, never named by the
// renderer. Folded onto Graph because a shape is registered on that graph's own
// host. Registration and instantiation take the updateSHACL / per-write
// governance path (§10.4, §5.5/§5.7); getShapes()/getShapeInstances()/
// getShapeInstanceData() are reads.
[Exposed=(Window,Worker), SecureContext]
partial interface Graph {
  // §5.2 — register |shapeDefinition| under |name| on this graph. Rejects
  // "SyntaxError" (malformed definition), "ConstraintError" (duplicate local
  // name / narrowing violation / unresolved extends), "NotAllowedError" (no
  // updateSHACL capability), "InvalidStateError".
  [CallWith=ScriptState, NewObject] Promise<undefined> addShape(DOMString name, object shapeDefinition);
  // §5.3 — drop |name|'s registration (requires updateSHACL). Existing instances
  // are left intact. Rejects "NotFoundError", "NotAllowedError".
  [CallWith=ScriptState, NewObject] Promise<undefined> removeShape(DOMString name);
  // §5.4 — the shapes registered on this graph plus, unless
  // options.includeInherited is false, the accepted shapes inherited from §7
  // parent graphs; local shapes shadow inherited shapes of the same name (§7.3).
  [CallWith=ScriptState, NewObject] Promise<sequence<ShapeInfo>> getShapes(optional GetShapesOptions options = {});
  // §5.5 — execute |shapeName|'s constructor into this graph. |address| empty
  // mints a fresh urn:uuid. |initialValues| maps property names to a single
  // lexical/IRI value each. Resolves with the instance address. Rejects
  // "NotFoundError" (unknown shape), "TypeError" (missing required property or
  // datatype failure), "NotAllowedError".
  [CallWith=ScriptState, NewObject] Promise<USVString> createShapeInstance(DOMString shapeName, USVString address, record<DOMString, DOMString> initialValues);
  // §5.6 — the addresses of every entity whose §4.5 rdf://type discriminator
  // matches |shapeName|'s targetClass. Rejects "NotFoundError".
  [CallWith=ScriptState, NewObject] Promise<sequence<USVString>> getShapeInstances(DOMString shapeName);
  // §5.6 — the full property dictionary of |address| under |shapeName| (each
  // property name → its ordered object values). Rejects "NotFoundError".
  [CallWith=ScriptState, NewObject] Promise<record<DOMString, sequence<DOMString>>> getShapeInstanceData(DOMString shapeName, USVString address);
  // §5.7 — the scalar setter: replace any existing value of |property| on
  // |address| with |value|. Rejects "NotFoundError", "NoModificationAllowedError"
  // (property has no setter), "InvalidAccessError" (property is a collection),
  // "TypeError", "NotAllowedError".
  [CallWith=ScriptState, NewObject] Promise<undefined> setShapeProperty(DOMString shapeName, USVString address, DOMString property, DOMString value);
  // §5.7 — add |value| to the collection property |collection| on |address|.
  // Rejects "NotFoundError", "InvalidAccessError" (property is scalar),
  // "TypeError", "NotAllowedError".
  [CallWith=ScriptState, NewObject] Promise<undefined> addToShapeCollection(DOMString shapeName, USVString address, DOMString collection, DOMString value);
  // §5.7 — remove |value| from the collection property |collection| on
  // |address|. Rejects "NotFoundError", "InvalidAccessError" (property is
  // scalar).
  [CallWith=ScriptState, NewObject] Promise<undefined> removeFromShapeCollection(DOMString shapeName, USVString address, DOMString collection, DOMString value);
};
