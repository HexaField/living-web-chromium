// MountMode — the authority a graph is mounted with. Graph Synchronisation
// Protocol spec §6.2. "read" receives diffs but cannot author them; "write"
// authors data; "governance" additionally authors governance triples.

enum MountMode {
  "read",
  "write",
  "governance"
};
