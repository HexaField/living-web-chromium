// Reifier — per-triple provenance (author, timestamp, method, signature).
// Personal Linked Data Graphs spec §3.7.

[Exposed=(Window,Worker)]
interface Reifier {
  readonly attribute USVString id;
  readonly attribute Triple triple;
  readonly attribute USVString author;     // DID URI (value of prov://author)
  readonly attribute DOMString timestamp;  // RFC 3339 (value of prov://timestamp)
  readonly attribute USVString method;     // verification method URI (prov://method)
  readonly attribute DOMString signature;  // multibase-encoded (prov://signature)
};
