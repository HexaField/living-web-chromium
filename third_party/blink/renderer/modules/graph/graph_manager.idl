// GraphManager — the navigator.graph entry point for creating and materialising
// graphs. Personal Linked Data Graphs spec §3.4.

[Exposed=(Window,Worker), SecureContext]
interface GraphManager {
  // Create a fresh, empty graph owned by the calling agent.
  [CallWith=ScriptState, NewObject] Promise<Graph> create(optional GraphCreationOptions options = {});
  // Materialise a graph from a previously-serialised snapshot.
  [CallWith=ScriptState, NewObject] Promise<Graph> fromSnapshot(GraphSnapshot snapshot, optional GraphFromSnapshotOptions options = {});
  // The snapshot formats this user agent can both produce and consume (spec
  // §5.3.4). Always contains "nquads-canonical", "nquads", "turtle"; "jsonld" is
  // OPTIONAL and omitted here. getAsSnapshot()/fromSnapshot() of a format absent
  // from this list reject with "NotSupportedError".
  static readonly attribute FrozenArray<SnapshotFormat> supportedSnapshotFormats;

  // Decentralised Group Identity §8.2. A "group" is a groupified Graph plus a
  // did:graph signing identity.
  //
  // createGroup mints a fresh host graph and groupifies it; forkGroup mints a
  // new identity over a copy of a parent's state; openGroup materialises a
  // handle over an already-mounted group; listGroups enumerates them.
  [CallWith=ScriptState, NewObject] Promise<Group> createGroup(GroupCreationOptions options);
  // §8.2.2 groupify — AMENDED from the spec's `groupify(USVString graphIri, …)`
  // to take the live Graph object. The host keys graphs by a stable internal id,
  // not the content-address IRI (which advances on every write, including
  // groupification itself); passing the Graph the caller already holds hands the
  // browser that stable id and avoids a lookup race. See SPEC_COMPLIANCE.md.
  [CallWith=ScriptState, NewObject] Promise<Group> groupify(Graph graph, GroupifyOptions options);
  [CallWith=ScriptState, NewObject] Promise<Group> forkGroup(USVString parentIriOrDid, ForkOptions options);
  [CallWith=ScriptState, NewObject] Promise<Group> openGroup(USVString iriOrDid);
  [CallWith=ScriptState, NewObject] Promise<sequence<Group>> listGroups();
};
